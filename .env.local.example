# Copy this file to .env.local and fill in your Supabase project details.
# Find these in your Supabase project: Settings -> API

# Public project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Same URL, used by server-side API routes
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key — SECRET. Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
